{
  "expo": {
    "name": "trustsim-mobile",
    "slug": "trustsim-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trustsimmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3A8A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "TrustSim cần quyền truy cập camera để chụp ảnh CCCD và chân dung xác thực eKYC."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TrustSim cần quyền lưu mã VietQR vào Thư viện ảnh để quét mã thanh toán bằng app ngân hàng.",
          "savePhotosPermission": "TrustSim cần quyền lưu mã VietQR vào Thư viện ảnh."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TrustSim cần quyền FaceID / sinh trắc học để xác thực ký kết hợp đồng và bảo mật tài khoản."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
